# Minimal single-work-group launch used for Phase 1: a trivial 1x1x1 NDRange so there is
# exactly one work-item and no cross-work-item bookkeeping to worry about yet.
kernel   kernels/vecadd.cl
name     vecadd
build    -g -cl-opt-disable

global   16
local    16

arg a  global float 16 in   iota
arg b  global float 16 in   iota:2
arg c  global float 16 out  zero
arg n  scalar int 16

print  c 0 16
expect c 0  0
expect c 1  3
expect c 15 45
